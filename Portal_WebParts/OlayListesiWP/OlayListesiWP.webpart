<?xml version="1.0" encoding="utf-8"?>
<webParts>
  <webPart xmlns="http://schemas.microsoft.com/WebPart/v3">
    <metaData>
      <type name="Portal_WebParts.OlayListesiWP.OlayListesiWP, $SharePoint.Project.AssemblyFullName$" />
      <importErrorMessage>$Resources:core,ImportErrorMessage;</importErrorMessage>
    </metaData>
    <data>
      <properties>
        <property name="Title" type="string">Geçmiş Olay Arşivi</property>
        <property name="Description" type="string">Eski sistemdeki olay kayıtlarına salt okunur erişim. Yeni kayıtlar Log İzleme ekranındadır.</property>
      </properties>
    </data>
  </webPart>
</webParts>
